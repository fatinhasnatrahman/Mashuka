# PORT: HTTP port for the Express storefront & CMS server (defaults to 3000)
PORT=3000

# ADMIN_SESSION_SECRET: Secret key used to sign admin session cookies in production.
# Set a long random string on your hosting control panel.
ADMIN_SESSION_SECRET="change-me-to-a-long-random-secret-on-hosting"

# ADMIN_INITIAL_PASSWORD: Initial password for the seeded Super Admin account when booting an empty database.
# Change this immediately after first sign-in or set a strong value before first deploy.
ADMIN_INITIAL_PASSWORD=""

# GEMINI_API_KEY: Optional runtime environment variable if AI features are added later.
GEMINI_API_KEY=""

# APP_URL: Public URL of your domain (e.g. https://yourdomain.com)
APP_URL="http://localhost:3000"
